{
  "name": "forge-agent",
  "version": "0.1.0",
  "description": "Local-first coding agent CLI optimized for local and small language models.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "forge": "bin/forge"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "USING_FORGE.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/ARCHITECTURE.md",
    "docs/PRODUCT_PLAN.md",
    "docs/ROADMAP.md",
    "docs/SECURITY.md",
    "docs/STATUS.md"
  ],
  "keywords": [
    "coding-agent",
    "local-llm",
    "cli",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepack": "npm run check && npm run build"
  },
  "dependencies": {
    "typescript-compiler": "npm:typescript@5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
