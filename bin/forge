#!/usr/bin/env node
// The only place process.exit appears.
import { existsSync, readFileSync, readdirSync, statSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

function newestSource(directory, suffix) {
  let newest = 0;
  for (const entry of readdirSync(directory, { withFileTypes: true })) {
    const target = path.join(directory, entry.name);
    if (entry.isDirectory()) newest = Math.max(newest, newestSource(target, suffix));
    else if (entry.name.endsWith(suffix)) newest = Math.max(newest, statSync(target).mtimeMs);
  }
  return newest;
}

const project = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const source = path.join(project, "src");
const built = path.join(project, "dist");
if (
  existsSync(source) &&
  existsSync(built) &&
  newestSource(source, ".ts") > newestSource(built, ".js")
) {
  process.stderr.write("Forge build is stale. Run `npm run build` before using bin/forge.\n");
  process.exit(2);
}

const argv = process.argv.slice(2);
const manifest = JSON.parse(readFileSync(path.join(project, "package.json"), "utf8"));
const currentVersion = typeof manifest.version === "string" ? manifest.version : "0.0.0";
const { bootstrapUpdate } = await import("../dist/update.js");
const update = await bootstrapUpdate({
  packageRoot: project,
  currentVersion,
  force: argv[0] === "update",
  io: {
    out: (text) => process.stdout.write(`${text}\n`),
    err: (text) => process.stderr.write(`${text}\n`),
  },
});
if (update.handled) process.exit(update.code);

// The updater runs before cli.js is imported. A successful global npm update
// therefore replaces dist/ first, and this invocation loads the new CLI rather
// than mixing old and new runtime modules.
const { main } = await import("../dist/cli.js");
process.exit(await main(argv));
